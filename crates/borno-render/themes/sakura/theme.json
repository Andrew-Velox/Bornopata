// Sakura: a lavender glass card with Pata, the Bornopata mascot, peeking over its corner, a hanging leaf charm, a bow,
// a crown, falling petals and a ribbon with two lines of Bangla. The left padding of 60 leaves room for her body and
// the charm; move the character and the padding together.
// All artwork (images/*.svg) was drawn for Bornopata and is released under GPL-3.0-or-later with the theme.
// The pictures are light, so the theme is locked to the light appearance.
{
  "extends": "bornopata",
  "schema": 1,
  "meta": { "id": "sakura", "name": "Sakura", "author": "Bornopata contributors", "license": "GPL-3.0-or-later", "appearance": "light" },

  "variables": {
    "text": "#47344f",
    "dim": "#47344f99",
    "gloss": "#ab8bb7",
    "faint": "#c3a9cc",
    "accent": "#c54f98",
    "star": "#e39a2d",
    "line": "#dab4db",
    "border": "#dab4db",
    "border_inner": "#ffffff00",
    "surface_top": "#f9eeff",
    "surface_bottom": "#f2e7fa",
    "pill_top": "#ffe9f7",
    "pill_bottom": "#f8cbe9",
    "chip": "#c54f9824",
    "ink": "#62486e",
    "ui": "#806289"
  },

  "text": {
    "styles": {
      "preedit": { "size": 16, "line_height": 22 },
      "ui": { "size": 13, "line_height": 17 },
      "small": { "size": 10, "line_height": 14 },
      "tagline": { "size": 12, "line_height": 16, "style": "italic" },
      "tag": { "size": 8, "line_height": 9 }
    }
  },

  "components": {
    "sakura_top": {
      "type": "frame", "padding": [2, 0, 6, 0], "align_self": "stretch",
      "children": [
        { "type": "preedit", "when": "preedit", "font": "preedit",
          "typed": "@ink", "rest": "#9c84a6", "caret": { "width": 1.5, "color": "@ink" } },
        { "type": "frame", "when": "hint", "margin": [3, 0, 0, 12], "padding": [1, 7, 1, 7], "fill": "@chip", "radius": 6,
          "children": [{ "type": "text", "bind": "hint", "font": "annotation", "color": "@accent" }] },
        { "type": "text", "text": "বাংলা", "when": "!mode.english", "font": "ui", "color": "@ui", "margin": [4, 0, 0, "auto"] },
        { "type": "text", "text": "EN", "when": "mode.english", "font": "ui", "color": "@ui", "margin": [4, 0, 0, "auto"] }
      ]
    },

    "ribbon": {
      "type": "frame", "align_self": "stretch", "height": 22, "radius": 11, "gap": 16,
      "fill": { "linear": 90, "stops": ["#d99ecfa6", ["#ffe3f5a6", 0.5], "#dbb7e9a6"] },
      "children": [
        { "type": "text", "text": "চলুন, আনন্দের গল্প লিখি।", "font": "small", "color": "#a98ab1", "margin": [4, 0, 0, 10] },
        { "type": "text", "text": "বর্ণপাতা তোমার সাথে লেখে।", "font": "tagline", "color": "#ad83ad", "margin": [3, 12, 0, "auto"] }
      ]
    },

    "petal": {
      "type": "frame", "width": 14, "height": 14, "fill": { "image": "images/petal.svg" },
      "animation": { "duration": 3600, "easing": "ease-in-out", "loop": true,
        "keyframes": [{ "at": 0, "y": 0, "rotate": 0 }, { "at": 0.5, "y": 3, "rotate": 14 }, { "at": 1, "y": 0, "rotate": 0 }] }
    },

    "pata": {
      "type": "frame", "position": "absolute", "inset": [-72, "auto", "auto", -24], "width": 137, "height": 150,
      "fill": { "image": "images/character.svg" },
      "animation": { "duration": 5200, "easing": "ease-in-out", "loop": true,
        "keyframes": [{ "at": 0, "y": 0 }, { "at": 0.5, "y": -1.5 }, { "at": 1, "y": 0 }] }
    }
  },

  "windows": {
    "vertical": {
      "type": "frame", "direction": "column", "padding": [10, 16, 8, 60], "min_width": 280, "radius": 18,
      "fill": { "linear": 180, "stops": [["@surface_top", 0], ["#fff6fc", 0.55], ["@surface_bottom", 1]] },
      "border": { "width": 1.5, "color": "@border" },
      "effects": [
        { "type": "drop-shadow", "y": 6, "blur": 14, "color": "#b889b540" },
        { "type": "inner-shadow", "blur": 4, "color": "#ffffffcc" }
      ],
      "children": [
        { "type": "use", "component": "sakura_top" },
        { "type": "frame", "when": "candidates", "align_self": "stretch", "height": 1, "fill": "#ffffffe6", "margin": [0, 0, 4, 0] },
        { "type": "frame", "when": "candidates", "table": { "row_height": 30 }, "align_self": "stretch",
          "children": [{ "type": "repeat", "bind": "candidates", "component": "row" }] },
        { "type": "use", "component": "ribbon", "margin": [8, -8, 0, -52] },

        { "type": "use", "component": "pata" },
        { "type": "frame", "position": "absolute", "inset": [-12, -20, "auto", "auto"], "width": 28, "height": 44,
          "fill": { "image": "images/charm.svg" } },
        { "type": "frame", "position": "absolute", "inset": [-11, 30, "auto", "auto"], "width": 26, "height": 18,
          "fill": { "image": "images/bow.svg" } },
        { "type": "frame", "position": "absolute", "inset": [-17, 86, "auto", "auto"], "width": 22, "height": 17,
          "fill": { "image": "images/crown.svg" } },
        { "type": "frame", "position": "absolute", "inset": [-12, 116, "auto", "auto"], "width": 9, "height": 9,
          "fill": { "image": "images/sparkle.svg" } },
        { "type": "frame", "position": "absolute", "inset": ["auto", 24, -9, "auto"], "width": 22, "height": 22,
          "fill": { "image": "images/blossom.svg" } },
        { "type": "use", "component": "petal", "position": "absolute", "inset": ["auto", "auto", -8, 90] }
      ]
    },

    "horizontal": {
      "type": "frame", "direction": "column", "padding": [10, 16, 8, 60], "min_width": 440, "radius": 18,
      "fill": { "linear": 180, "stops": [["@surface_top", 0], ["#fff6fc", 0.55], ["@surface_bottom", 1]] },
      "border": { "width": 1.5, "color": "@border" },
      "effects": [
        { "type": "drop-shadow", "y": 6, "blur": 14, "color": "#b889b540" },
        { "type": "inner-shadow", "blur": 4, "color": "#ffffffcc" }
      ],
      "children": [
        { "type": "use", "component": "sakura_top" },
        { "type": "frame", "when": "candidates", "align_self": "stretch", "height": 1, "fill": "#ffffffe6" },
        { "type": "frame", "when": "candidates", "align_self": "stretch", "margin": [4, 0, 0, 0], "gap": 10,
          "children": [{ "type": "repeat", "bind": "candidates", "component": "item" }] },
        { "type": "use", "component": "ribbon", "margin": [8, -8, 0, -52] },

        { "type": "use", "component": "pata" },
        { "type": "frame", "position": "absolute", "inset": [-12, -30, "auto", "auto"], "width": 28, "height": 44,
          "fill": { "image": "images/charm.svg" } },
        { "type": "frame", "position": "absolute", "inset": [-12, 36, "auto", "auto"], "width": 30, "height": 21,
          "fill": { "image": "images/bow.svg" } },
        { "type": "frame", "position": "absolute", "inset": [-19, 190, "auto", "auto"], "width": 26, "height": 20,
          "fill": { "image": "images/crown.svg" } },
        { "type": "use", "component": "petal", "position": "absolute", "inset": [-7, "auto", "auto", 140] },
        { "type": "frame", "position": "absolute", "inset": ["auto", "auto", -14, 230], "width": 30, "height": 30,
          "fill": { "image": "images/blossom.svg" } },
        { "type": "frame", "position": "absolute", "inset": ["auto", 28, -9, "auto"], "width": 22, "height": 22,
          "fill": { "image": "images/blossom.svg" } },
        { "type": "use", "component": "petal", "position": "absolute", "inset": ["auto", "auto", -9, 110] },
        { "type": "frame", "position": "absolute", "inset": [-14, 236, "auto", "auto"], "width": 10, "height": 10,
          "fill": { "image": "images/sparkle.svg" } }
      ]
    }
  }
}
