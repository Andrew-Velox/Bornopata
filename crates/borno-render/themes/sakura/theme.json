// Sakura: a bright pink glass card with a mascot peeking over the top-left edge, a bow, a crown and falling petals.
// `popup_overhang` says how far decoration may hang over the card in the Wayland popup (top, right, bottom, left, in
// points); the mascot's table edge is the card's top edge, 53 points below the top of her picture.
// The vector artwork (images/*.svg) was drawn for Bornopata and is released under GPL-3.0-or-later with the theme.
// images/character.png was supplied by the project owner, made with ChatGPT from an original prompt (see README.md).
// The pictures are light, so the theme is locked to the light appearance.
{
  "extends": "bornopata",
  "schema": 1,
  "meta": { "id": "sakura", "name": "Sakura", "author": "Bornopata contributors", "license": "GPL-3.0-or-later AND LicenseRef-Character", "appearance": "light",
            "popup_overhang": [58, 0, 14, 10] },

  "variables": {
    "text": "#47344f",
    "dim": "#47344f99",
    "gloss": "#47344fa6",
    "faint": "#8a6f94",
    "accent": "#d0508f",
    "star": "#e39a2d",
    "line": "#d0508f26",
    "border": "#efa9c7",
    "border_inner": "#d0508fb3",
    "surface_top": "#fffafc",
    "surface_bottom": "#fbe8f2",
    "pill_top": "#ffdcec",
    "pill_bottom": "#ffc6df",
    "chip": "#d0508f24",
    "ink": "#47344f",
    "ui": "#a8527f"
  },

  "text": {
    "styles": {
      "preedit": { "size": 16, "line_height": 22 },
      "ui": { "size": 13, "line_height": 17 },
      "small": { "size": 10, "line_height": 14 },
      "tagline": { "size": 12, "line_height": 16, "style": "italic" },
      "tag": { "size": 8, "line_height": 9 }
    }
  },

  "components": {
    "sakura_top": {
      "type": "frame", "padding": [2, 0, 6, 0], "align_self": "stretch",
      "children": [
        { "type": "preedit", "when": "preedit", "font": "preedit",
          "typed": "@ink", "rest": "#9c84a6", "caret": { "width": 1.5, "color": "@ink" } },
        { "type": "frame", "when": "hint", "margin": [3, 0, 0, 12], "padding": [1, 7, 1, 7], "fill": "@chip", "radius": 6,
          "children": [{ "type": "text", "bind": "hint", "font": "annotation", "color": "@accent" }] },
        { "type": "text", "text": "বাংলা", "when": "!mode.english", "font": "ui", "color": "@ui", "margin": [4, 0, 0, "auto"] },
        { "type": "text", "text": "EN", "when": "mode.english", "font": "ui", "color": "@ui", "margin": [4, 0, 0, "auto"] }
      ]
    },

    "petal": {
      "type": "frame", "width": 14, "height": 14, "fill": { "image": "images/petal.svg" },
      "animation": { "duration": 3600, "easing": "ease-in-out", "loop": true,
        "keyframes": [{ "at": 0, "y": 0, "rotate": 0 }, { "at": 0.5, "y": 3, "rotate": 14 }, { "at": 1, "y": 0, "rotate": 0 }] }
    },

    "petals": {
      "type": "frame", "position": "absolute", "inset": [0, 0, 0, 0],
      "children": [
        { "type": "frame", "position": "absolute", "inset": [6, "auto", "auto", 130], "width": 11, "height": 11,
          "fill": { "image": "images/petal.svg" },
          "animation": { "duration": 5200, "easing": "ease-in-out", "loop": true, "keyframes": [
            { "at": 0, "x": 0, "y": -4, "rotate": 0, "opacity": 0 },
            { "at": 0.15, "opacity": 0.95 },
            { "at": 0.6, "x": 12, "y": 22, "rotate": 140, "opacity": 0.9 },
            { "at": 1, "x": -4, "y": 46, "rotate": 300, "opacity": 0 }
          ] } },
        { "type": "frame", "position": "absolute", "inset": [4, 90, "auto", "auto"], "width": 9, "height": 9,
          "fill": { "image": "images/petal.svg" },
          "animation": { "duration": 6400, "easing": "ease-in-out", "loop": true, "keyframes": [
            { "at": 0, "x": 0, "y": -2, "rotate": 40, "opacity": 0 },
            { "at": 0.2, "opacity": 0.85 },
            { "at": 0.65, "x": -14, "y": 26, "rotate": -120, "opacity": 0.8 },
            { "at": 1, "x": 6, "y": 50, "rotate": -280, "opacity": 0 }
          ] } }
      ]
    },

    "crown": {
      "type": "frame", "fill": { "image": "images/crown.svg" },
      "animation": { "duration": 3600, "easing": "ease-in-out", "loop": true,
        "keyframes": [
          { "at": 0, "y": 0, "rotate": -3 },
          { "at": 0.5, "y": -2.5, "rotate": 3 },
          { "at": 1, "y": 0, "rotate": -3 }
        ] }
    },

    "mascot": {
      "type": "frame", "position": "absolute", "inset": [-53, "auto", "auto", -10], "width": 104, "height": 68,
      "fill": { "image": "images/character.png", "scale": 3 }
    },

    "blossom": {
      "type": "frame", "fill": { "image": "images/blossom.svg" },
      "animation": { "duration": 9000, "easing": "ease-in-out", "loop": true, "keyframes": [
        { "at": 0, "rotate": -6 }, { "at": 0.5, "rotate": 6 }, { "at": 1, "rotate": -6 }
      ] }
    }
  },

  "windows": {
    "vertical": {
      "type": "frame", "direction": "column", "padding": [10, 16, 8, 16], "min_width": 280, "radius": 16,
      "fill": { "linear": 160, "stops": ["@surface_top", "@surface_bottom"] },
      "border": { "width": 3, "color": "@border" },
      "effects": [],
      "children": [
        { "type": "frame", "position": "absolute", "inset": [0, 0, 0, 0], "radius": 13,
          "border": { "width": 1, "color": "@border_inner" } },
        { "type": "use", "component": "sakura_top" },
        { "type": "frame", "when": "candidates", "align_self": "stretch", "height": 1, "fill": "#ffffffe6", "margin": [0, 0, 4, 0] },
        { "type": "frame", "when": "candidates", "table": { "row_height": 30 }, "align_self": "stretch",
          "children": [{ "type": "repeat", "bind": "candidates", "component": "row" }] },

        { "type": "use", "component": "petals" },
        { "type": "use", "component": "mascot" },
        { "type": "frame", "position": "absolute", "inset": [-11, 30, "auto", "auto"], "width": 26, "height": 18,
          "fill": { "image": "images/bow.svg" } },
        { "type": "use", "component": "crown", "position": "absolute", "inset": [-17, 86, "auto", "auto"], "width": 22, "height": 17 },
        { "type": "frame", "position": "absolute", "inset": [-12, 116, "auto", "auto"], "width": 9, "height": 9,
          "fill": { "image": "images/sparkle.svg" } },
        { "type": "use", "component": "blossom", "position": "absolute", "inset": ["auto", 24, -9, "auto"], "width": 22, "height": 22 },
        { "type": "use", "component": "petal", "position": "absolute", "inset": ["auto", "auto", -8, 90] }
      ]
    },

    "horizontal": {
      "type": "frame", "direction": "column", "padding": [10, 16, 8, 16], "min_width": 440, "radius": 16,
      "fill": { "linear": 160, "stops": ["@surface_top", "@surface_bottom"] },
      "border": { "width": 3, "color": "@border" },
      "effects": [],
      "children": [
        { "type": "frame", "position": "absolute", "inset": [0, 0, 0, 0], "radius": 13,
          "border": { "width": 1, "color": "@border_inner" } },
        { "type": "use", "component": "sakura_top" },
        { "type": "frame", "when": "candidates", "align_self": "stretch", "height": 1, "fill": "#ffffffe6" },
        { "type": "frame", "when": "candidates", "align_self": "stretch", "margin": [4, 0, 0, 0], "gap": 10,
          "children": [{ "type": "repeat", "bind": "candidates", "component": "item" }] },

        { "type": "use", "component": "petals" },
        { "type": "use", "component": "mascot" },
        { "type": "frame", "position": "absolute", "inset": [-12, 36, "auto", "auto"], "width": 30, "height": 21,
          "fill": { "image": "images/bow.svg" } },
        { "type": "use", "component": "crown", "position": "absolute", "inset": [-19, 190, "auto", "auto"], "width": 26, "height": 20 },
        { "type": "use", "component": "petal", "position": "absolute", "inset": [-7, "auto", "auto", 140] },
        { "type": "use", "component": "blossom", "position": "absolute", "inset": ["auto", "auto", -14, 230], "width": 30, "height": 30 },
        { "type": "use", "component": "blossom", "position": "absolute", "inset": ["auto", 28, -9, "auto"], "width": 22, "height": 22 },
        { "type": "use", "component": "petal", "position": "absolute", "inset": ["auto", "auto", -9, 110] },
        { "type": "frame", "position": "absolute", "inset": [-14, 236, "auto", "auto"], "width": 10, "height": 10,
          "fill": { "image": "images/sparkle.svg" } }
      ]
    }
  }
}
