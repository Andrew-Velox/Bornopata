// Bornopata: a soft rounded card with a leaf-green accent. Rows are marked by where the word came from:
// a star for a word chosen before, a trailing dots mark for completions, an arrow for next-word suggestions.
{
  "schema": 1,
  "meta": { "id": "bornopata", "name": "Bornopata", "author": "Bornopata contributors", "license": "GPL-3.0-or-later" },

  "variables": {
    "text": { "light": "#1b2a26", "dark": "#eef5f2" },
    "dim": { "light": "#1b2a2699", "dark": "#eef5f299" },
    "gloss": { "light": "#1b2a26a6", "dark": "#eef5f2b3" },
    "faint": { "light": "#1b2a2673", "dark": "#eef5f273" },
    "accent": { "light": "#1f8a6e", "dark": "#4fcfa8" },
    "star": { "light": "#e09a00", "dark": "#ffc233" },
    "line": { "light": "#1b2a2614", "dark": "#ffffff1f" },
    "surface_top": { "light": "#ffffff", "dark": "#26302d" },
    "surface_bottom": { "light": "#f1f8f5", "dark": "#1c2421" },
    "pill_top": { "light": "#d8f0e6", "dark": "#2c5a4a" },
    "pill_bottom": { "light": "#c4e6d7", "dark": "#244a3c" },
    "chip": { "light": "#1f8a6e1f", "dark": "#4fcfa826" }
  },

  "text": {
    "gamma": { "light": 0.85, "dark": 0.75 },
    "family": ["Noto Sans Bengali", "system"],
    "styles": {
      "candidate": { "size": 17, "line_height": 24 },
      "annotation": { "size": 12, "line_height": 16 },
      "index": { "size": 11, "line_height": 16 }
    }
  },

  "components": {
    "top_line": {
      "type": "frame", "when": "preedit|hint", "padding": [2, 4, 6, 4], "gap": 12, "align_self": "stretch",
      "children": [
        { "type": "preedit", "when": "preedit", "font": "annotation",
          "typed": "@gloss", "rest": "@faint",
          "caret": { "width": 1.5, "color": "@accent" } },
        { "type": "frame", "when": "hint", "margin": [0, 0, 0, "auto"], "padding": [1, 7, 1, 7],
          "fill": "@chip", "radius": 6, "children": [
            { "type": "text", "bind": "hint", "font": "annotation", "color": "@accent" }
          ] }
      ]
    },

    "word": {
      "type": "frame",
      "children": [
        { "type": "icon", "icon": "star", "when": "learned", "size": 11, "height": 24,
          "color": "@star", "margin": [0, 5, 0, 0] },
        { "type": "text", "text": "→", "when": "next", "font": "candidate", "color": "@accent", "margin": [0, 6, 0, 0] },
        { "type": "text", "bind": "text", "when": "completion", "font": "candidate",
          "color": { "if": "highlighted", "then": "@text", "else": "@dim" } },
        { "type": "text", "bind": "text", "when": "!completion", "font": "candidate", "color": "@text" },
        { "type": "text", "text": "…", "when": "completion", "font": "annotation", "color": "@faint", "margin": [4, 0, 0, 3] }
      ]
    },

    "row": {
      "type": "frame",
      "children": [
        { "type": "frame", "id": "highlight", "transition": { "duration": 110, "easing": "ease-out" },
          "when": "highlighted", "span": "row", "margin": [0, -4, 0, -4],
          "fill": { "linear": 180, "stops": ["@pill_top", "@pill_bottom"] }, "radius": 9 },
        { "type": "text", "bind": "index", "font": "index", "margin": [9, 0, 0, 0],
          "color": { "if": "highlighted", "then": "@accent", "else": "@faint" } },
        { "type": "use", "component": "word", "margin": [4, 0, 0, 9] },
        { "type": "annotation", "bind": "annotation", "when": "annotations", "font": "annotation",
          "gloss": "@gloss", "fresh": "@star", "faint": "@faint", "margin": [9, 0, 0, 9] }
      ]
    },

    "item": {
      "type": "frame", "padding": [0, 0, 4, 0],
      "children": [
        { "type": "frame", "id": "highlight", "transition": { "duration": 110, "easing": "ease-out" },
          "when": "highlighted", "position": "absolute", "inset": [0, -5, 0, -5],
          "fill": { "linear": 180, "stops": ["@pill_top", "@pill_bottom"] }, "radius": 9 },
        { "type": "text", "bind": "index", "font": "index", "margin": [9, 3, 0, 0],
          "color": { "if": "highlighted", "then": "@accent", "else": "@faint" } },
        { "type": "use", "component": "word", "margin": [4, 0, 0, 0] }
      ]
    }
  },

  "windows": {
    "vertical": {
      "type": "frame", "direction": "column", "padding": 10, "min_width": 190,
      "fill": { "linear": 180, "stops": ["@surface_top", "@surface_bottom"] }, "radius": 14,
      "border": { "width": 1, "color": "@line" },
      "effects": [
        { "type": "drop-shadow", "y": 10, "blur": 24, "color": "#0000002e" },
        { "type": "drop-shadow", "y": 1, "blur": 3, "color": "#00000020" }
      ],
      "children": [
        { "type": "use", "component": "top_line" },
        { "type": "frame", "when": "candidates", "table": { "row_height": 30 }, "align_self": "stretch",
          "children": [{ "type": "repeat", "bind": "candidates", "component": "row" }] }
      ]
    },
    "horizontal": {
      "type": "frame", "direction": "column", "padding": 10,
      "fill": { "linear": 180, "stops": ["@surface_top", "@surface_bottom"] }, "radius": 14,
      "border": { "width": 1, "color": "@line" },
      "effects": [
        { "type": "drop-shadow", "y": 10, "blur": 24, "color": "#0000002e" },
        { "type": "drop-shadow", "y": 1, "blur": 3, "color": "#00000020" }
      ],
      "children": [
        { "type": "use", "component": "top_line" },
        { "type": "frame", "when": "candidates", "align_self": "stretch", "padding": [0, 5, 0, 5], "gap": 10,
          "children": [{ "type": "repeat", "bind": "candidates", "component": "item" }] }
      ]
    }
  }
}
