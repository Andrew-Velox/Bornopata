# Copy to .env and edit. Every variable has a default; missing ones are not an error.

# Log level filter (tracing-subscriber EnvFilter syntax)
RUST_LOG=info,borno_core=debug

# Log file directory, rolled daily; leave empty to log to the terminal only
BORNOPATA_LOG_DIR=logs

# Learning language of the inherited gloss feature: en / ja / es / de
BORNOPATA_LEARNING_LANGUAGE=en
